# Server Configuration
PORT=3001
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata
DATABASE_URL=./data/minimi.db
LOG_LEVEL=info

# LLM Provider Configuration (options: groq | grok | openai | gemini | mock)
# If GROQ_API_KEY is configured, Groq is the default live LLM provider.
# If no key is set or LLM_PROVIDER=mock, the built-in deterministic mock provider will be used.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Optional custom base URL for Groq API (defaults to https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional xAI Grok LLM Provider
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1

# Optional OpenAI LLM Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Google Gemini LLM Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Web Search Provider Configuration (options: tavily | brave | serpapi | mock)
# If TAVILY_API_KEY is configured, Tavily is the default live search provider.
# If no key is set or SEARCH_PROVIDER=mock, the mock search provider will be used.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Embedding Provider (options: openai | mock)
# Optional: if omitted or mock, system gracefully falls back to SQLite FTS5 lexical + structured retrieval.
EMBEDDING_PROVIDER=openai
